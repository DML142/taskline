# Render supplies PORT automatically; this value is useful for local production-mode runs.
PORT=10000
DATABASE_URL=postgres://replace-with-production-database-url
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ISSUER=taskline-api
JWT_AUDIENCE=taskline-web
WEB_ORIGIN=https://app.example.com
COOKIE_SECURE=true
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=2587
SMTP_USERNAME=replace-with-ses-smtp-username
SMTP_PASSWORD=replace-with-ses-smtp-password
SMTP_FROM='Taskline <verified-sender@example.com>'
SMTP_TLS_MODE=starttls
